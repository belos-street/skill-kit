{
  "name": "@belos-street/skill-kit",
  "version": "1.0.1",
  "description": "CLI tool for managing skill documentation - generate agents and skill directories",
  "type": "module",
  "main": "./index.ts",
  "bin": {
    "skill-kit": "./bin/skill-kit"
  },
  "scripts": {
    "dev": "bun run ./index.ts -h",
    "build": "bun build ./index.ts --outdir dist --target bun",
    "build:binary": "bun build ./index.ts --outfile bin/skill-kit --target bun --compile",
    "publish": "bun run ./scripts/publish.ts"
  },
  "files": [
    "bin/",
    "lib/",
    "skills/",
    "index.ts",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/belos-street/skill-kit"
  },
  "keywords": [
    "cli",
    "skill",
    "documentation",
    "agents",
    "ai"
  ],
  "author": "belos-street",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/belos-street/skill-kit/issues"
  },
  "homepage": "https://github.com/belos-street/skill-kit#readme",
  "devDependencies": {
    "@types/bun": "latest",
    "@types/prompts": "^2.4.9"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "chalk": "4",
    "commander": "^14.0.3",
    "ora": "^9.3.0",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2"
  }
}